# ========================================
# Docker Compose Environment Variables
# ========================================
# Copy to .env and fill in real values. NEVER commit secrets.

# MongoDB Atlas (URL encode special characters!)
MONGODB_URI=YOUR_MONGODB_URI

# JWT Secret (64+ chars) — generate with: openssl rand -hex 64
JWT_SECRET=YOUR_JWT_SECRET

# Telco Provider
TELCO_PROVIDER=Vodacom

# Admin Dashboard Password
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD

# EasySendSMS Configuration
EASYSENDSMS_API_KEY=YOUR_EASYSENDSMS_API_KEY
EASYSENDSMS_SENDER_ID=YOUR_EASYSENDSMS_SENDER_ID
SMS_ENABLED=false
